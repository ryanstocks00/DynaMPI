#!/bin/bash
#PBS -l select=128:ncpus=102:mpiprocs=102
#PBS -l walltime=00:40:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_shutdown_small_7
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
APP="$HOME/DynaMPI/build/benchmark/shutdown_time"

RPN=7
NODE_LIST="128 64 32 16 8 4 2 1"

for nodes in $NODE_LIST; do
  ranks=$((nodes * RPN))
  for dist in naive hierarchical; do
    echo "##### shutdown dist=$dist nodes=$nodes ranks_per_node=$RPN #####"
    timeout 90 mpiexec -n "$ranks" --ppn "$RPN" "$APP" --distribution "$dist" --nodes "$nodes" --system aurora
    echo "exit=$?"
  done
done
echo "ALL DONE"
