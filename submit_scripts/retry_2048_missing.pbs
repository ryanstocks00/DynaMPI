#!/bin/bash
#PBS -l select=2048:ncpus=102:mpiprocs=102
#PBS -l walltime=00:05:00
#PBS -q prod
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_retry_2048_missing
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

NODES=2048
RANKS=$((NODES * 7))

echo "##### dist=lockfree_rma fanout=-1 nodes=2048 mode=uniform expected_us=100 rpn=7 #####"
timeout 90 mpiexec -n "$RANKS" --ppn 7 "$SS" --distribution lockfree_rma --mode random \
  --expected_us 100 --duration_s 20 --nodes "$NODES" --max_upper_fanout -1 --system aurora
echo "exit=$?"

echo "ALL DONE"
