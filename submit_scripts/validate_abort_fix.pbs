#!/bin/bash
#PBS -l select=2:ncpus=102:mpiprocs=102
#PBS -l walltime=00:10:00
#PBS -q debug
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_validate_abort
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"
SD="$HOME/DynaMPI/build/benchmark/shutdown_time"

echo "##### sanity: naive, fast, should complete normally #####"
start=$(date +%s)
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution naive --mode random \
  --expected_us 10 --duration_s 5 --nodes 2 --system aurora
echo "exit=$? elapsed=$(($(date +%s) - start))s"

echo "##### the actual failure case: lockfree_rma, expected_us=1000000 (1s/task) #####"
echo "##### previously hung/timed out at 90s waiting on finalize() drain #####"
start=$(date +%s)
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution lockfree_rma --mode random \
  --expected_us 1000000 --duration_s 5 --nodes 2 --system aurora
echo "exit=$? elapsed=$(($(date +%s) - start))s"

echo "##### hierarchical_lockfree_rma, same failure case #####"
start=$(date +%s)
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution hierarchical_lockfree_rma --mode random \
  --expected_us 1000000 --duration_s 5 --nodes 2 --max_upper_fanout 0 --system aurora
echo "exit=$? elapsed=$(($(date +%s) - start))s"

echo "##### shutdown_time sanity: new lockfree_rma support #####"
start=$(date +%s)
timeout 30 mpiexec -n 204 --ppn 102 "$SD" --distribution lockfree_rma --nodes 2 --system aurora
echo "exit=$? elapsed=$(($(date +%s) - start))s"

echo "##### shutdown_time sanity: new hierarchical_lockfree_rma support #####"
start=$(date +%s)
timeout 30 mpiexec -n 204 --ppn 102 "$SD" --distribution hierarchical_lockfree_rma --nodes 2 --system aurora
echo "exit=$? elapsed=$(($(date +%s) - start))s"

echo "ALL DONE"
