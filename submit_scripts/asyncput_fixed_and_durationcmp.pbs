#!/bin/bash
#PBS -l select=128:ncpus=102:mpiprocs=102
#PBS -l walltime=00:45:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_fix_durcmp
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

NODE_LIST="1 2 4 8 16 32 64 128"

echo "===== corrected chunk-size: async-put sweep ====="
for dist in lockfree_rma hierarchical_lockfree_rma; do
  for nodes in $NODE_LIST; do
    ranks=$((nodes * 102))
    echo "##### $dist nodes=$nodes expected_us=1000 duration_s=10 #####"
    timeout 60 mpiexec -n "$ranks" --ppn 102 "$SS" --distribution "$dist" --mode random \
      --expected_us 1000 --duration_s 10 --nodes "$nodes" --system aurora
    echo "exit=$?"
  done
done

echo "===== corrected chunk-size: 128-node reliability (5x each) ====="
for dist in lockfree_rma hierarchical_lockfree_rma; do
  for i in 1 2 3 4 5; do
    echo "##### $dist nodes=128 expected_us=1000 duration_s=10 trial=$i #####"
    timeout 60 mpiexec -n 13056 --ppn 102 "$SS" --distribution "$dist" --mode random \
      --expected_us 1000 --duration_s 10 --nodes 128 --system aurora
    echo "exit=$?"
  done
done

echo "===== hierarchical (message-passing) duration_s comparison, same allocation ====="
for i in 1 2 3; do
  echo "##### hierarchical nodes=128 duration_s=10 trial=$i #####"
  timeout 30 mpiexec -n 13056 --ppn 102 "$SS" --distribution hierarchical --mode random \
    --expected_us 1000 --duration_s 10 --nodes 128 --system aurora
  echo "exit=$?"
done
for i in 1 2 3; do
  echo "##### hierarchical nodes=128 duration_s=20 trial=$i #####"
  timeout 40 mpiexec -n 13056 --ppn 102 "$SS" --distribution hierarchical --mode random \
    --expected_us 1000 --duration_s 20 --nodes 128 --system aurora
  echo "exit=$?"
done
for i in 1 2 3; do
  echo "##### hierarchical nodes=128 duration_s=30 trial=$i #####"
  timeout 50 mpiexec -n 13056 --ppn 102 "$SS" --distribution hierarchical --mode random \
    --expected_us 1000 --duration_s 30 --nodes 128 --system aurora
  echo "exit=$?"
done

echo "ALL DONE"
