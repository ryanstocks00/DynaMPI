#!/bin/bash
#PBS -l select=256:ncpus=102:mpiprocs=102
#PBS -l walltime=00:50:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_resubmit_failures_512
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

run_one() {
  local dist="$1" fanout="$2" nodes="$3" mode="$4" us="$5" rpn="$6"
  local ranks=$((nodes * rpn))
  echo "##### RETRY dist=$dist fanout=$fanout nodes=$nodes mode=$mode expected_us=$us rpn=$rpn #####"
  timeout 90 mpiexec -n "$ranks" --ppn "$rpn" "$SS" --distribution "$dist" --mode "$mode" \
    --expected_us "$us" --duration_s 20 --nodes "$nodes" --max_upper_fanout "$fanout" --system aurora
  echo "exit=$?"
}

echo "===== targeted chunk-timeout reruns (now fixed by MPI_Abort) ====="
run_one async_put_lockfree -1 128 fixed 1000000 102
run_one async_put_lockfree -1 128 random 1000000 102
run_one async_put_lockfree -1 16 fixed 1000000 102
run_one async_put_lockfree -1 16 fixed 100000 102
run_one async_put_lockfree -1 16 random 1000000 102
run_one async_put_lockfree -1 16 random 100000 102
run_one async_put_lockfree -1 1 fixed 1000000 102
run_one async_put_lockfree -1 1 fixed 100000 102
run_one async_put_lockfree -1 1 random 1000000 102
run_one async_put_lockfree -1 1 random 100000 102
run_one async_put_lockfree -1 2 fixed 1000000 102
run_one async_put_lockfree -1 2 fixed 100000 102
run_one async_put_lockfree -1 2 random 1000000 102
run_one async_put_lockfree -1 2 random 100000 102
run_one async_put_lockfree -1 32 fixed 1000000 102
run_one async_put_lockfree -1 32 random 1000000 102
run_one async_put_lockfree -1 4 fixed 1000000 102
run_one async_put_lockfree -1 4 fixed 100000 102
run_one async_put_lockfree -1 4 random 1000000 102
run_one async_put_lockfree -1 4 random 100000 102
run_one async_put_lockfree -1 64 fixed 1000000 102
run_one async_put_lockfree -1 64 random 1000000 102
run_one async_put_lockfree -1 8 fixed 1000000 102
run_one async_put_lockfree -1 8 fixed 100000 102
run_one async_put_lockfree -1 8 random 1000000 102
run_one async_put_lockfree -1 8 random 100000 102
run_one hierarchical_async_put_lockfree 0 128 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 128 random 1000000 102
run_one hierarchical_async_put_lockfree 0 16 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 16 fixed 100000 102
run_one hierarchical_async_put_lockfree 0 16 random 1000000 102
run_one hierarchical_async_put_lockfree 0 16 random 100000 102
run_one hierarchical_async_put_lockfree 0 1 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 1 fixed 100000 102
run_one hierarchical_async_put_lockfree 0 1 random 1000000 102
run_one hierarchical_async_put_lockfree 0 1 random 100000 102
run_one hierarchical_async_put_lockfree 0 2 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 2 fixed 100000 102
run_one hierarchical_async_put_lockfree 0 2 random 1000000 102
run_one hierarchical_async_put_lockfree 0 2 random 100000 102
run_one hierarchical_async_put_lockfree 0 32 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 32 random 1000000 102
run_one hierarchical_async_put_lockfree 0 4 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 4 fixed 100000 102
run_one hierarchical_async_put_lockfree 0 4 random 1000000 102
run_one hierarchical_async_put_lockfree 0 4 random 100000 102
run_one hierarchical_async_put_lockfree 0 64 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 64 random 1000000 102
run_one hierarchical_async_put_lockfree 0 8 fixed 1000000 102
run_one hierarchical_async_put_lockfree 0 8 fixed 100000 102
run_one hierarchical_async_put_lockfree 0 8 random 1000000 102
run_one hierarchical_async_put_lockfree 0 8 random 100000 102
run_one hierarchical_async_put_lockfree -1 128 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 128 random 1000000 102
run_one hierarchical_async_put_lockfree -1 16 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 16 fixed 100000 102
run_one hierarchical_async_put_lockfree -1 16 random 1000000 102
run_one hierarchical_async_put_lockfree -1 16 random 100000 102
run_one hierarchical_async_put_lockfree -1 1 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 1 fixed 100000 102
run_one hierarchical_async_put_lockfree -1 1 random 1000000 102
run_one hierarchical_async_put_lockfree -1 1 random 100000 102
run_one hierarchical_async_put_lockfree -1 2 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 2 fixed 100000 102
run_one hierarchical_async_put_lockfree -1 2 random 1000000 102
run_one hierarchical_async_put_lockfree -1 2 random 100000 102
run_one hierarchical_async_put_lockfree -1 32 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 32 random 1000000 102
run_one hierarchical_async_put_lockfree -1 4 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 4 fixed 100000 102
run_one hierarchical_async_put_lockfree -1 4 random 1000000 102
run_one hierarchical_async_put_lockfree -1 4 random 100000 102
run_one hierarchical_async_put_lockfree -1 64 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 64 random 1000000 102
run_one hierarchical_async_put_lockfree -1 8 fixed 1000000 102
run_one hierarchical_async_put_lockfree -1 8 fixed 100000 102
run_one hierarchical_async_put_lockfree -1 8 random 1000000 102
run_one hierarchical_async_put_lockfree -1 8 random 100000 102

echo "===== targeted rpn=7 (gpu7) chunk-timeout reruns ====="
run_one hierarchical_async_put_lockfree 0 256 fixed 1000000 7
run_one hierarchical_async_put_lockfree 0 256 random 1000000 7

echo "===== full rerun: 256 nodes, rpn=102, mode=random (job crashed on first combo) ====="
EXPECTED_US_LIST="10 100 1000 10000 100000 1000000"
for us in $EXPECTED_US_LIST; do
  run_one naive -1 256 random "$us" 102
  run_one hierarchical 0 256 random "$us" 102
  run_one hierarchical -1 256 random "$us" 102
  run_one async_put_lockfree -1 256 random "$us" 102
  run_one hierarchical_async_put_lockfree 0 256 random "$us" 102
  run_one hierarchical_async_put_lockfree -1 256 random "$us" 102
done

echo "ALL DONE"
