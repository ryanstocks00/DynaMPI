#!/bin/bash
#PBS -l select=2048:ncpus=102:mpiprocs=102
#PBS -l walltime=00:30:00
#PBS -q prod
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_finish_gpu7_large_2048_random
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

NODES=2048
MODE=random

run_one() {
  local dist="$1" fanout="$2" us="$3"
  local ranks=$((NODES * 7))
  echo "##### dist=$dist fanout=$fanout nodes=$NODES mode=$MODE expected_us=$us rpn=7 #####"
  timeout 90 mpiexec -n "$ranks" --ppn 7 "$SS" --distribution "$dist" --mode "$MODE" \
    --expected_us "$us" --duration_s 20 --nodes "$NODES" --max_upper_fanout "$fanout" --system aurora
  echo "exit=$?"
}

EXPECTED_US_LIST="10 100 1000 10000 100000 1000000"
for us in $EXPECTED_US_LIST; do
  # naive/us=10 already completed successfully -- skip it.
  if [ "$us" != "10" ]; then
    run_one naive -1 "$us"
  fi
  run_one hierarchical 0 "$us"
  run_one hierarchical -1 "$us"
  run_one async_put_lockfree -1 "$us"
  run_one hierarchical_async_put_lockfree 0 "$us"
  run_one hierarchical_async_put_lockfree -1 "$us"
done

echo "ALL DONE"
