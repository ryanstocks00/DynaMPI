#!/bin/bash
#PBS -l select=256:ncpus=102:mpiprocs=102
#PBS -l walltime=00:45:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_errbar_256
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

EXPECTED_US_LIST="10 1000"

run_one() {
  local dist="$1" fanout="$2" us="$3"
  echo "##### dist=$dist fanout=$fanout nodes=256 expected_us=$us duration_s=20 #####"
  timeout 90 mpiexec -n 26112 --ppn 102 "$SS" --distribution "$dist" --mode random \
    --expected_us "$us" --duration_s 20 --nodes 256 --max_upper_fanout "$fanout" --system aurora
  echo "exit=$?"
}

for us in $EXPECTED_US_LIST; do
  run_one naive -1 "$us"
  run_one hierarchical 0 "$us"
  run_one hierarchical -1 "$us"
  run_one async_put_lockfree -1 "$us"
  run_one hierarchical_async_put_lockfree 0 "$us"
  run_one hierarchical_async_put_lockfree -1 "$us"
done

echo "ALL DONE"
