#!/bin/bash
#PBS -l select=128:ncpus=102:mpiprocs=102
#PBS -l walltime=00:45:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_hier_128_d10
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

NODE_LIST="1 2 4 8 16 32 64 128"

for nodes in $NODE_LIST; do
  ranks=$((nodes * 102))
  echo "##### hierarchical nodes=$nodes expected_us=1000 duration_s=10 #####"
  timeout 60 mpiexec -n "$ranks" --ppn 102 "$SS" --distribution hierarchical --mode random \
    --expected_us 1000 --duration_s 10 --nodes "$nodes" --system aurora
  echo "exit=$?"
done

echo "===== 128-node reliability trials (5x) ====="
for i in 1 2 3 4 5; do
  echo "##### hierarchical nodes=128 expected_us=1000 duration_s=10 trial=$i #####"
  timeout 60 mpiexec -n 13056 --ppn 102 "$SS" --distribution hierarchical --mode random \
    --expected_us 1000 --duration_s 10 --nodes 128 --system aurora
  echo "exit=$?"
done

echo "ALL DONE"
