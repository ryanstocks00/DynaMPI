#!/bin/bash
#PBS -l select=64:ncpus=102:mpiprocs=102
#PBS -l walltime=00:15:00
#PBS -q debug-scaling
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -N dynampi_rerun_ss_64_hapl
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

NODES=64
RPN=102

run_one() {
  local mode="$1" us="$2"
  local ranks=$((NODES * RPN))
  echo "##### dist=hierarchical_async_put_lockfree fanout=-1 nodes=$NODES mode=$mode expected_us=$us rpn=$RPN #####"
  timeout 90 mpiexec -n "$ranks" --ppn "$RPN" "$SS" --distribution hierarchical_async_put_lockfree \
    --mode "$mode" --expected_us "$us" --duration_s 20 --nodes "$NODES" --max_upper_fanout -1 --system aurora
  echo "exit=$?"
}

for mode in fixed random; do
  for us in 10 100 1000 10000 100000 1000000; do
    run_one "$mode" "$us"
  done
done

echo "ALL DONE"
