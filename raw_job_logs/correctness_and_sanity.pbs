#!/bin/bash
#PBS -l select=2:ncpus=102:mpiprocs=102
#PBS -l walltime=00:15:00
#PBS -q debug
#PBS -A DynaMPI
#PBS -l filesystems=flare
#PBS -j oe

cd "$HOME/DynaMPI" || exit 1
export FI_CXI_RX_MATCH_MODE=software
BIN="$HOME/DynaMPI/build/test/mpi_test"
SS="$HOME/DynaMPI/build/benchmark/strong_scaling_distribution_rate"

for n in 1 2 4 8 16 32 64 102 150 204; do
  ppn=$n
  if [ "$ppn" -gt 102 ]; then ppn=102; fi
  echo "=== ranks=$n ppn=$ppn ==="
  timeout 90 mpiexec -n "$n" --ppn "$ppn" "$BIN" --gtest_brief=1
  rc=$?
  echo "=== ranks=$n exit=$rc ==="
  if [ $rc -ne 0 ]; then echo "FAILURE at ranks=$n"; fi
done
echo "CORRECTNESS DONE"

echo "=== async_put_lockfree sanity, nodes=2, duration_s=5 ==="
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution async_put_lockfree --mode random \
  --expected_us 1000 --duration_s 5 --nodes 2 --system aurora
echo "exit=$?"

echo "=== hierarchical_async_put_lockfree sanity, nodes=2, duration_s=5 ==="
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution hierarchical_async_put_lockfree --mode random \
  --expected_us 1000 --duration_s 5 --nodes 2 --system aurora
echo "exit=$?"

echo "=== async_put_lockfree sanity, nodes=2, duration_s=5, fast expected_us=10 ==="
timeout 30 mpiexec -n 204 --ppn 102 "$SS" --distribution async_put_lockfree --mode random \
  --expected_us 10 --duration_s 5 --nodes 2 --system aurora
echo "exit=$?"

echo "ALL DONE"
